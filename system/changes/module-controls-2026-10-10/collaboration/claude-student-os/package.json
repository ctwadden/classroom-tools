  "description": "Student OS pilot — local demonstration and proposed Apps Script source. No dependencies.",
  "scripts": {
    "demo": "node local/server.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.cjs tests/*.test.mjs",
